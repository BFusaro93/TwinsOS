{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/integrations/samsara/sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/automations/run",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/contract-invoices",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/recurring-visits",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/crm/estimates/expiry-notify",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/contract-expiry-notify",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/crm/estimates/automation-date-triggers",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/scheduled-campaigns",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/invoice-past-due",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ticket-past-due",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/card-expiry-notify",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-seat-overage",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/bill-sms-overage",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/report-schedules",
      "schedule": "0 12 * * *"
    }
  ]
}
