# Supabase — copy this file to .env.local and fill in your project credentials
# Local dev:  found at http://localhost:54321 after running `npx supabase start`
# Remote:     found in your Supabase project dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for server-side admin operations (service role bypasses RLS — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — subscription billing (Settings → Subscription)
# Get these from https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
# Leave unset and the Subscription tab shows a "not connected" state instead of erroring.
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
# From the webhook endpoint's "Signing secret" once you've added the endpoint below
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here

# One Stripe Price ID per plan tier (Product catalog → your product → pricing).
# A plan with no price ID configured shows as "Not configured" in the UI instead of erroring.
STRIPE_PRICE_STARTER=price_your-starter-monthly-price-id
STRIPE_PRICE_CMMS=price_your-cmms-monthly-price-id
STRIPE_PRICE_GROWTH=price_your-growth-monthly-price-id
STRIPE_PRICE_ENTERPRISE=price_your-enterprise-monthly-price-id

# One Stripe Price ID per add-on (src/lib/stripe/addons.ts). SMS is metered;
# the rest are flat monthly toggles. An add-on with no price ID configured
# shows as "Not configured" in the UI instead of erroring.
STRIPE_PRICE_ADDON_SMS=price_your-addon-sms-price-id
STRIPE_PRICE_ADDON_JOB_PHOTOS=price_your-addon-job-photos-price-id
STRIPE_PRICE_ADDON_CLIENT_PORTAL=price_your-addon-client-portal-price-id
STRIPE_PRICE_ADDON_ROUTE_OPTIMIZATION=price_your-addon-route-optimization-price-id
STRIPE_PRICE_ADDON_ADVANCED_REPORTING=price_your-addon-advanced-reporting-price-id
STRIPE_PRICE_ADDON_API_ACCESS=price_your-addon-api-access-price-id

# Stripe — integrated CRM invoice card payments (Charge Card / Pay Now)
# Uses the same STRIPE_SECRET_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above.
# LEGACY: only still needed to finish processing PaymentIntents created before
# Connect onboarding shipped (see /api/crm/payments/webhook/route.ts) — new
# crm_invoice payments are created on each org's connected account instead and
# handled by STRIPE_CONNECT_WEBHOOK_SECRET below. Safe to leave unset once no
# pre-Connect PaymentIntents are still in flight.
STRIPE_CRM_PAYMENTS_WEBHOOK_SECRET=whsec_your-crm-payments-webhook-signing-secret-here

# Stripe Connect — per-tenant payouts (CRM Settings → Accounting → Card Payments)
# Each org connects its own Standard Stripe account. New crm_invoice card
# payments are created directly on that connected account (a "direct charge"),
# so both account status sync AND crm_invoice payment events arrive here:
#   - account.updated keeps organizations.stripe_connect_status/
#     charges_enabled/payouts_enabled in sync
#   - payment_intent.succeeded / payment_intent.payment_failed apply the
#     payment to the invoice, same as the legacy webhook above used to
# Add a Connect-scoped webhook endpoint at /api/crm/payments/connect-webhook
# (Dashboard → Webhooks → "Listen to events on Connected accounts"), select all
# three events above, and paste its signing secret here. Uses the same
# STRIPE_SECRET_KEY as above.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-signing-secret-here
